# VAMS Neuron — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ─── DBOS System Database ─────────────────────────────────────────────────────
# DBOS requires PostgreSQL to store workflow state, step results, and crash-
# recovery checkpoints. SQLite is NOT supported.
#
# Option A: Local Docker (fastest for development)
#   docker run -d --name vams-pg \
#     -e POSTGRES_USER \
#     -e POSTGRES_PASSWORD \
#     -e POSTGRES_DB \
#     -p 5432:5432 postgres:16
#
DBOS_SYSTEM_DATABASE_URL=
# Structure only; inject values through your local untracked environment:
# postgresql://${DB_USER}:${DB_PASSWORD}@localhost:5432/${DB_NAME}

# Option B: Neon serverless (free tier, no local Docker needed)
#   1. Sign up at https://neon.tech
#   2. Create project "vams-neuron"
#   3. Copy the connection string from the dashboard
#
# postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}/${DB_NAME}?sslmode=require

# ─── VAMS Protocol ────────────────────────────────────────────────────────────
# VAMS_PRIVATE_KEY=0x...        # EVM private key for on-chain ops
# VAMS_IRYS_KEY=...             # Irys/Arweave upload key
# VAMS_KWIL_DB=...              # Kwil database identifier
