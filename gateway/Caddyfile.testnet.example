# HISTORICAL TEMPLATE — UNSUPPORTED FOR M2/LIVE GATEWAY USE.
#
# Envoy 1.39.1 with gateway/envoy.testnet.yaml is the sole reviewed live
# ingress. This Caddy template is retained only as historical context and must
# not be used as a public, testnet, staging, or production Gateway boundary.
#
# VAMS public testnet gateway proxy example (superseded).
#
# Historical context only. Do not run this template for a VAMS Gateway.
# Replace the domain and CA path with the live testnet values before deployment.

{$VAMS_GATEWAY_DOMAIN:gateway.vams.network} {
	encode zstd gzip

	request_body {
		max_size 1MB
	}

	tls {
		client_auth {
			mode require_and_verify
			trust_pool file {$VAMS_ROOT_CA_CERT:/etc/caddy/certs/vams-root-ca.crt}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:; frame-ancestors 'none'; base-uri 'none'"
	}

	reverse_proxy 127.0.0.1:8000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-VAMS-Client-Cert-Verified "success"
		header_up X-VAMS-Client-Cert-Fingerprint "{http.request.tls.client.fingerprint}"
	}
}
