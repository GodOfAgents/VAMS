{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vams.network/schemas/audit/cardano-preprod-parameters.schema.json",
  "title": "VAMS Cardano Pre-Prod Public Script Parameters",
  "type": "object",
  "required": ["schema_version", "commit_sha", "network", "persistent_parameters_cbor", "auxiliary_policy_instances"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "network": {"const": "cardano-preprod"},
    "persistent_parameters_cbor": {
      "type": "object",
      "required": [
        "agent_registry.agent_registry.spend",
        "governor.governor.spend",
        "insurance_fund.insurance_fund.spend",
        "timelock.timelock.spend"
      ],
      "properties": {
        "agent_registry.agent_registry.spend": {"$ref": "#/$defs/parameters"},
        "governor.governor.spend": {"$ref": "#/$defs/parameters"},
        "insurance_fund.insurance_fund.spend": {"$ref": "#/$defs/parameters"},
        "timelock.timelock.spend": {"$ref": "#/$defs/parameters"}
      },
      "additionalProperties": false
    },
    "auxiliary_policy_instances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["instance_id", "title", "parameters_cbor"],
        "properties": {
          "instance_id": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
          },
          "title": {
            "enum": [
              "agent_nft.agent_nft.mint",
              "proposal_nft.proposal_nft.mint",
              "fund_nft.fund_nft.mint"
            ]
          },
          "parameters_cbor": {"$ref": "#/$defs/parameters"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "parameters": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "pattern": "^(?:[0-9a-f]{2})+$"
      }
    }
  },
  "additionalProperties": false
}
