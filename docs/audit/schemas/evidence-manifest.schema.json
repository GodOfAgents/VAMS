{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vams.network/schemas/audit/evidence-manifest.schema.json",
  "title": "VAMS Audit Evidence Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "commit_sha",
    "stage_evidence_run_id",
    "operational_evidence_run_id",
    "seed",
    "dirty",
    "generated_at",
    "environment",
    "control_matrix_sha256",
    "bundle_sha256",
    "track_summary",
    "evidence_artifacts",
    "results"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "stage_evidence_run_id": {"type": "integer", "minimum": 1},
    "operational_evidence_run_id": {"type": "integer", "minimum": 1},
    "seed": {"const": 20260713},
    "dirty": {"const": false},
    "generated_at": {"type": "string", "format": "date-time"},
    "environment": {"const": "github-actions"},
    "control_matrix_sha256": {"$ref": "#/$defs/sha256"},
    "bundle_sha256": {"$ref": "#/$defs/sha256"},
    "track_summary": {
      "type": "object",
      "required": ["total", "planned", "partial", "implemented", "verified", "blocked"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "planned": {"type": "integer", "minimum": 0},
        "partial": {"type": "integer", "minimum": 0},
        "implemented": {"type": "integer", "minimum": 0},
        "verified": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "evidence_artifacts": {
      "type": "array",
      "minItems": 15,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/artifactBinding"}
    },
    "results": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "required": ["name", "status", "command", "artifact_path", "artifact_sha256", "raw_outputs", "reviewer"],
        "properties": {
          "name": {"enum": ["audit-program", "public-content", "default-credentials", "mock-mode", "gitleaks", "trufflehog", "solidity", "slither", "aiken", "vir-core", "python", "semgrep", "frontend", "gateway-config", "sbom"]},
          "status": {"const": "success"},
          "command": {"type": "string", "minLength": 1},
          "artifact_path": {"$ref": "#/$defs/bundlePath"},
          "artifact_sha256": {"$ref": "#/$defs/sha256"},
          "raw_outputs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/artifactBinding"}
          },
          "reviewer": {"const": "github-actions"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bundlePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*(?:^|/)audit-evidence\\.(?:json|sig|pem)$)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "artifactBinding": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/bundlePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
