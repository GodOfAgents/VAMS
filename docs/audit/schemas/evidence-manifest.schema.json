{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vams.network/schemas/audit/evidence-manifest.schema.json",
  "title": "VAMS Audit Evidence Manifest",
  "type": "object",
  "required": ["schema_version", "commit_sha", "dirty", "generated_at", "environment", "control_matrix_sha256", "track_summary", "evidence_artifacts", "results"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "dirty": {"const": false},
    "generated_at": {"type": "string", "format": "date-time"},
    "environment": {"const": "github-actions"},
    "control_matrix_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "track_summary": {
      "type": "object",
      "required": ["total", "planned", "partial", "implemented", "verified", "blocked"],
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "evidence_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "results": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "required": ["name", "status", "command", "artifact_sha256", "reviewer"],
        "properties": {
          "name": {"enum": ["audit-program", "public-content", "default-credentials", "mock-mode", "gitleaks", "trufflehog", "solidity", "slither", "aiken", "vir-core", "python", "semgrep", "frontend", "gateway-config", "sbom"]},
          "status": {"enum": ["success", "failure", "skipped", "pending"]},
          "command": {"type": "string", "minLength": 1},
          "artifact_sha256": {"type": ["string", "null"]},
          "reviewer": {"const": "github-actions"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
