{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vams.network/schemas/audit/credential-incident-report.schema.json",
  "title": "VAMS Historical Credential Incident Closure Report",
  "type": "object",
  "required": [
    "schema_version",
    "commit_sha",
    "incident_id",
    "affected_identities",
    "history_rewrite",
    "full_history_scans",
    "reviewer",
    "reviewer_organization",
    "reviewed_at",
    "blocking_findings_open"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "commit_sha": {"$ref": "#/$defs/commit"},
    "incident_id": {"const": "VAMS-PEM-2026-001"},
    "affected_identities": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identity"}
    },
    "history_rewrite": {"$ref": "#/$defs/historyRewrite"},
    "full_history_scans": {
      "type": "object",
      "required": ["gitleaks", "trufflehog"],
      "properties": {
        "gitleaks": {"$ref": "#/$defs/scan"},
        "trufflehog": {"$ref": "#/$defs/scan"}
      },
      "additionalProperties": false
    },
    "reviewer": {"type": "string", "minLength": 1},
    "reviewer_organization": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "blocking_findings_open": {"const": 0}
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^docs/audit/evidence/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "roleCheck": {
      "type": "object",
      "required": ["clear", "evidence"],
      "properties": {
        "clear": {"const": true},
        "evidence": {"$ref": "#/$defs/artifact"}
      },
      "additionalProperties": false
    },
    "fundingCheck": {
      "oneOf": [
        {"$ref": "#/$defs/accountDerivedFundingCheck"},
        {"$ref": "#/$defs/cryptographicallyInapplicableFundingCheck"}
      ]
    },
    "accountDerivedFundingCheck": {
      "type": "object",
      "required": ["network", "applicability", "public_identifier", "observed_at", "zero_balance", "evidence"],
      "properties": {
        "network": {"enum": ["polygon-amoy", "cardano-preprod"]},
        "applicability": {"const": "account-derived"},
        "public_identifier": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "zero_balance": {"const": true},
        "evidence": {"$ref": "#/$defs/artifact"}
      },
      "additionalProperties": false
    },
    "cryptographicallyInapplicableFundingCheck": {
      "type": "object",
      "required": ["network", "applicability", "observed_at", "non_applicability_reason", "evidence"],
      "properties": {
        "network": {"enum": ["polygon-amoy", "cardano-preprod"]},
        "applicability": {"const": "cryptographically-inapplicable"},
        "observed_at": {"type": "string", "format": "date-time"},
        "non_applicability_reason": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/artifact"}
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "required": [
        "fingerprint_sha256",
        "key_type",
        "revoked_at",
        "replacement_fingerprint_sha256",
        "public_identifiers",
        "role_impact_checks",
        "funding_checks",
        "revocation_evidence"
      ],
      "properties": {
        "fingerprint_sha256": {"$ref": "#/$defs/sha256"},
        "key_type": {"type": "string", "minLength": 1},
        "revoked_at": {"type": "string", "format": "date-time"},
        "replacement_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
        "public_identifiers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "role_impact_checks": {
          "type": "object",
          "required": ["deployment_signer", "funded_account", "node", "provider", "safe", "timelock", "validator"],
          "properties": {
            "deployment_signer": {"$ref": "#/$defs/roleCheck"},
            "funded_account": {"$ref": "#/$defs/roleCheck"},
            "node": {"$ref": "#/$defs/roleCheck"},
            "provider": {"$ref": "#/$defs/roleCheck"},
            "safe": {"$ref": "#/$defs/roleCheck"},
            "timelock": {"$ref": "#/$defs/roleCheck"},
            "validator": {"$ref": "#/$defs/roleCheck"}
          },
          "additionalProperties": false
        },
        "funding_checks": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/fundingCheck"}
        },
        "revocation_evidence": {"$ref": "#/$defs/artifact"}
      },
      "additionalProperties": false
    },
    "historyRewrite": {
      "type": "object",
      "required": [
        "completed",
        "completed_at",
        "all_refs_rewritten",
        "collaborators_recloned",
        "forks_coordinated",
        "github_cached_refs_purged",
        "changed_refs_evidence",
        "github_support_evidence"
      ],
      "properties": {
        "completed": {"const": true},
        "completed_at": {"type": "string", "format": "date-time"},
        "all_refs_rewritten": {"const": true},
        "collaborators_recloned": {"const": true},
        "forks_coordinated": {"const": true},
        "github_cached_refs_purged": {"const": true},
        "changed_refs_evidence": {"$ref": "#/$defs/artifact"},
        "github_support_evidence": {"$ref": "#/$defs/artifact"}
      },
      "additionalProperties": false
    },
    "scan": {
      "type": "object",
      "required": ["full_history", "findings_count", "command", "evidence"],
      "properties": {
        "full_history": {"const": true},
        "findings_count": {"const": 0},
        "command": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/artifact"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
