{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vams.network/schemas/audit/team-signer-governance.schema.json",
  "title": "VAMS Team Signer Bootstrap Governance Evidence",
  "description": "Owner decision 12. Shape only; scripts/audit/team_signer_governance.py is authoritative and also enforces exact membership per authority, distinct keys and the overlap disclosure.",
  "type": "object",
  "required": ["schema_version", "commit_sha", "governance_mode", "decentralized_governance_claimed", "independent_review_claimed", "externally_audited_claimed", "signers", "offline_recovery_seats", "authorities", "consent_records", "rehearsals", "emergency_response_target_seconds", "limitations", "blocking_findings_open"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "governance_mode": {"const": "team-controlled-bootstrap"},
    "decentralized_governance_claimed": {"const": false},
    "independent_review_claimed": {"const": false},
    "externally_audited_claimed": {"const": false},
    "signers": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["role", "evm_address", "cardano_key_hash", "historical_pem_relationship", "independent_key_custody"],
        "properties": {
          "role": {"enum": ["ARCHITECT", "SIGNER_A", "SIGNER_B", "SIGNER_C"]},
          "evm_address": {"$ref": "#/$defs/evmAddress"},
          "cardano_key_hash": {"$ref": "#/$defs/cardanoHash"},
          "historical_pem_relationship": {"const": false},
          "independent_key_custody": {"const": true}
        },
        "additionalProperties": false
      }
    },
    "offline_recovery_seats": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["role", "evm_address", "cardano_key_hash", "historical_pem_relationship", "custody_mode", "custodians", "custody_threshold", "routine_use", "rotate_after_use"],
        "properties": {
          "role": {"enum": ["GOVERNANCE_RECOVERY", "TREASURY_RECOVERY"]},
          "evm_address": {"$ref": "#/$defs/evmAddress"},
          "cardano_key_hash": {"$ref": "#/$defs/cardanoHash"},
          "historical_pem_relationship": {"const": false},
          "custody_mode": {"const": "2-of-3-split-custody"},
          "custodians": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["SIGNER_A", "SIGNER_B", "SIGNER_C"]}},
          "custody_threshold": {"const": 2},
          "routine_use": {"const": false},
          "rotate_after_use": {"const": true}
        },
        "additionalProperties": false
      }
    },
    "authorities": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "threshold", "members", "scope", "identity"],
        "properties": {
          "id": {"enum": ["amoy-governance", "amoy-treasury", "amoy-emergency", "cardano-governance"]},
          "threshold": {"enum": [2, 3]},
          "members": {"type": "array", "minItems": 3, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["ARCHITECT", "SIGNER_A", "SIGNER_B", "SIGNER_C", "GOVERNANCE_RECOVERY", "TREASURY_RECOVERY"]}},
          "scope": {"enum": ["governance", "faucet-only-treasury", "pause-only"]},
          "identity": {"type": "string", "pattern": "^(0x[0-9a-fA-F]{40}|[0-9a-f]{56})$"}
        },
        "additionalProperties": false
      }
    },
    "consent_records": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["role", "consented", "understands_authority", "independent_key_custody_confirmed", "emergency_channel_recorded", "compromise_reporting_accepted", "amoy_rehearsal_completed", "evidence_path", "evidence_sha256"],
        "properties": {
          "role": {"enum": ["ARCHITECT", "SIGNER_A", "SIGNER_B", "SIGNER_C"]},
          "consented": {"const": true},
          "understands_authority": {"const": true},
          "independent_key_custody_confirmed": {"const": true},
          "emergency_channel_recorded": {"const": true},
          "compromise_reporting_accepted": {"const": true},
          "amoy_rehearsal_completed": {"const": true},
          "evidence_path": {"$ref": "#/$defs/safePath"},
          "evidence_sha256": {"$ref": "#/$defs/sha256"}
        },
        "additionalProperties": false
      }
    },
    "rehearsals": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": ["scenario", "passed", "evidence_path", "evidence_sha256"],
        "properties": {
          "scenario": {"enum": ["amoy-governance-3-of-5", "amoy-treasury-3-of-5", "amoy-emergency-2-of-3", "cardano-governance-3-of-5", "unavailable-signer", "rejected-transaction", "lost-key-replacement", "recovery-split-custody", "human-readable-transaction-review"]},
          "passed": {"const": true},
          "evidence_path": {"$ref": "#/$defs/safePath"},
          "evidence_sha256": {"$ref": "#/$defs/sha256"}
        },
        "additionalProperties": false
      }
    },
    "emergency_response_target_seconds": {"type": "integer", "minimum": 1},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "blocking_findings_open": {"const": 0}
  },
  "$defs": {
    "evmAddress": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "cardanoHash": {"type": "string", "pattern": "^[0-9a-f]{56}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}
  },
  "additionalProperties": false
}
