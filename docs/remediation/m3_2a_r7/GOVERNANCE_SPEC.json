        "source": "compiled artifact"
      },
      {
        "name": "fixed_authorizers",
        "type": "array[5] bytes28",
        "source": "immutable genesis datum"
      },
      {
        "name": "threshold",
        "type": "u32",
        "source": "immutable genesis datum"
      }
    ],
    "runtime_overrides": "reject",
    "fixture_values": "non-admission only"
  },
