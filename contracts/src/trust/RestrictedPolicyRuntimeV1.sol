pragma solidity ^0.8.20;

/// @notice Exact runtime identity check for the captured RestrictedTestnetPolicyV1 build.
/// @dev This checks code identity for caller-supplied expected immutable values; it does not
///      establish that those values are trusted, deployed, governed, or authorized.
library RestrictedPolicyRuntimeV1 {
    uint256 internal constant EXPECTED_RUNTIME_LENGTH = 9982;
    // Provenance pins only; these constants do not confer trust or identify a deployed instance.
    bytes32 internal constant CAPTURED_RUNTIME_TEMPLATE_SHA256 = 0xbd317c3c7a648b079daf6a62b83aaffab14f454ddb1014cd14228925e0148b1d;
    bytes32 internal constant CAPTURED_POLICY_SOURCE_SHA256 = 0x8b7dd049565cea5fe9be3c06313b34b437c4f04d53de4577f000401ad45df62e;
    bytes32 internal constant CAPTURED_ARTIFACT_JSON_SHA256 = 0x263d0efbb8e3e633401e50812eed6c2fb7e96a59ade543c686ac2629ab9d5b6c;
    bytes32 internal constant CAPTURED_SOLC_BINARY_SHA256 = 0xfb03a29a517452b9f12bcf459ef37d0a543765bb3bbc911e70a87d6a37c30d5f;
    bytes32 internal constant CAPTURED_FOUNDRY_BINARY_SHA256 = 0x4f77da0810de94325734855d0ad58d70640aa8a5b2a837608ddf8c26da34355c;

    /// @notice Hashes the captured compiler runtime after substituting its three known immutables.
    /// @dev Zero/missing bindings return zero. The pinned template is from solc 0.8.24, optimizer
    ///      enabled at 200 runs, Cancun, non-viaIR, IPFS metadata, exact source/settings capture.
    function expectedCodeHash(address governance, bytes32 hostDomain, bytes32 budgetUnit)
        internal pure returns (bytes32)
    {
        if (governance == address(0) || hostDomain == bytes32(0) || budgetUnit == bytes32(0)) {
            return bytes32(0);
        }

        bytes memory runtime = _runtimeTemplate();
        bytes32 governanceWord = bytes32(uint256(uint160(governance)));

        // solc immutableReferences IDs 3928/3930/3932; every range is exactly 32 bytes.
        _patchWord(runtime, 412, governanceWord);
        _patchWord(runtime, 855, governanceWord);
        _patchWord(runtime, 1407, governanceWord);
        _patchWord(runtime, 1853, governanceWord);

        _patchWord(runtime, 523, hostDomain);
        _patchWord(runtime, 1225, hostDomain);
        _patchWord(runtime, 3356, hostDomain);
        _patchWord(runtime, 4123, hostDomain);
        _patchWord(runtime, 4623, hostDomain);

        _patchWord(runtime, 484, budgetUnit);
        _patchWord(runtime, 1258, budgetUnit);
        _patchWord(runtime, 3389, budgetUnit);
        _patchWord(runtime, 4170, budgetUnit);
        _patchWord(runtime, 4656, budgetUnit);

        return keccak256(runtime);
    }

    /// @notice Checks exact runtime size and extcodehash against the pinned template and bindings.
    /// @dev Does not call policy getters. Expected immutable values remain external trust inputs.
    function matches(address policy, address governance, bytes32 hostDomain, bytes32 budgetUnit)
        internal view returns (bool)
    {
        if (policy == address(0) || governance == address(0) || hostDomain == bytes32(0) ||
            budgetUnit == bytes32(0) || policy.code.length != EXPECTED_RUNTIME_LENGTH) {
            return false;
        }

        bytes32 expected = expectedCodeHash(governance, hostDomain, budgetUnit);
        if (expected == bytes32(0)) return false;

        bytes32 actual;
        assembly {
            actual := extcodehash(policy)
        }
        return actual != bytes32(0) && actual == expected;
    }

    function _patchWord(bytes memory runtime, uint256 offset, bytes32 value) private pure {
        // Offsets are byte indexes into deployed runtime, not memory indexes.
        assembly {
            mstore(add(add(runtime, 0x20), offset), value)
        }
    }

    function _runtimeTemplate() private pure returns (bytes memory) {
        return hex"";
    }
}
