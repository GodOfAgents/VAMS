pragma solidity ^0.8.20;
import {Test} from "forge-std/Test.sol";
import {ActionContextV1 as A} from "../src/trust/ActionContextV1.sol";
import {GovernedObjectGrantV1 as G} from "../src/trust/GovernedObjectGrantV1.sol";
import {EffectReceiptV3 as R} from "../src/trust/EffectReceiptV3.sol";
import {ObjectEffectV3 as O} from "../src/trust/ObjectEffectV3.sol";
/// Public fixture keys 1/2, generated by actual Python cryptography. No live issuer evidence.
contract ObjectReceiptPythonGoldenTest is Test {
function authorityKey() internal pure returns(bytes memory){return hex"0479be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798483ada7726a3c4655da4fbfc0e1108a8fd17b448a68554199c47d08ffb10d4b8";}
function providerKey() internal pure returns(bytes memory){return hex"04c6047f9441ed7d6d3045406e95c07cd85c778e4b8cef3ca7abac09b95c709ee51ae168fea63dc339a3c58419466ceaeef7f632653266d0e1236431a950cfe52a";}
function admissionBytes() internal pure returns(bytes memory){return hex"";}
function updateBytes() internal pure returns(bytes memory){return hex"";}
function ackBytes() internal pure returns(bytes memory){return hex"";}
function effectBytes() internal pure returns(bytes memory){return hex"";}
function absenceBytes() internal pure returns(bytes memory){return hex"";}
function proposal() internal pure returns(G.Proposal memory p){p.context=abi.decode(hex"",(A.Context));p.resourceId=hex"49c6d90012ed0633c4d67cb147bcf1a3151614111db07116f5a2da18b887e46b";p.costUnits=3;p.fencingToken=9;}
function fence() internal pure returns(O.Fence memory){return abi.decode(hex"",(O.Fence));}

function test_pythonCanonicalObjectAndFenceCommitments() public pure {
    G.Proposal memory p=proposal();
    assertEq(O.digest(p),hex"e944abaf92b24d24f9c4e5f782d2519a8f523fa29928f5e761f99921cb68f1b4");
    assertEq(G.operationId(p),hex"3367b11562b6a4ddc393ee7ac806a6bccc67b49bc10f29642afc8cbc92c23929");
    assertEq(G.actionHash(p),hex"a4a1341325dfd8b338bb15dd9fc4ec218015279bbc732d2db155dfa1b222142c");
    assertEq(O.postcondition(p),hex"55ef034abc14178990f1acf2edef9a3e1c74c3c6e4f15343b846481cc34359f3");
    assertEq(O.fenceDigest(fence()),hex"eb9b29d0890d31775b4ce67a8cb26fdbca23191f91a7fd88b749f91efac3cbae");
}
function test_allFivePythonSignedReceiptBytesVerifyWithExactDigests() public pure {
    {
      (bool decoded,R.Receipt memory r,)=R.tryDecode(admissionBytes());assertTrue(decoded);
      assertEq(R.digest(r),hex"8420c9cc376a051d2f8b8e6dfc80cb3331a5ab8c42d8239d5daa25ba23007ee6");
      R.Expected memory e=R.Expected(r.issuerId,r.subjectDigest,r.providerId,r.purpose,r.authorityEpoch,r.policyVersion,r.fencingToken);
      (bool valid,bytes32 d)=R.verify(admissionBytes(),authorityKey(),e,r.issuedAt,false);assertTrue(valid);assertEq(d,hex"8420c9cc376a051d2f8b8e6dfc80cb3331a5ab8c42d8239d5daa25ba23007ee6");
    }
    {
      (bool decoded,R.Receipt memory r,)=R.tryDecode(updateBytes());assertTrue(decoded);
      assertEq(R.digest(r),hex"7ad4852c2de00566ab5865aacff4a838e5d17cb86d3fbe6ad724d6ad6aa39edb");
      R.Expected memory e=R.Expected(r.issuerId,r.subjectDigest,r.providerId,r.purpose,r.authorityEpoch,r.policyVersion,r.fencingToken);
      (bool valid,bytes32 d)=R.verify(updateBytes(),authorityKey(),e,r.issuedAt,false);assertTrue(valid);assertEq(d,hex"7ad4852c2de00566ab5865aacff4a838e5d17cb86d3fbe6ad724d6ad6aa39edb");
    }
    {
      (bool decoded,R.Receipt memory r,)=R.tryDecode(ackBytes());assertTrue(decoded);
      assertEq(R.digest(r),hex"383154ba9b2645c715ef7b655d4ac25be796d25fabbc9b72d234f64f0174e4dd");
      R.Expected memory e=R.Expected(r.issuerId,r.subjectDigest,r.providerId,r.purpose,r.authorityEpoch,r.policyVersion,r.fencingToken);
      (bool valid,bytes32 d)=R.verify(ackBytes(),providerKey(),e,r.issuedAt,false);assertTrue(valid);assertEq(d,hex"383154ba9b2645c715ef7b655d4ac25be796d25fabbc9b72d234f64f0174e4dd");
    }
    {
      (bool decoded,R.Receipt memory r,)=R.tryDecode(effectBytes());assertTrue(decoded);
      assertEq(R.digest(r),hex"56de72a8f49b1b99de1baa22b677fad571d0e2b1f5011517451e2bb4d3658938");
      R.Expected memory e=R.Expected(r.issuerId,r.subjectDigest,r.providerId,r.purpose,r.authorityEpoch,r.policyVersion,r.fencingToken);
      (bool valid,bytes32 d)=R.verify(effectBytes(),providerKey(),e,r.issuedAt,false);assertTrue(valid);assertEq(d,hex"56de72a8f49b1b99de1baa22b677fad571d0e2b1f5011517451e2bb4d3658938");
    }
    {
      (bool decoded,R.Receipt memory r,)=R.tryDecode(absenceBytes());assertTrue(decoded);
      assertEq(R.digest(r),hex"7335f9b427a03c77ca373c9f549de9c6102d3ba59783020e5c0f09560f7ec305");
      R.Expected memory e=R.Expected(r.issuerId,r.subjectDigest,r.providerId,r.purpose,r.authorityEpoch,r.policyVersion,r.fencingToken);
      (bool valid,bytes32 d)=R.verify(absenceBytes(),providerKey(),e,r.issuedAt,false);assertTrue(valid);assertEq(d,hex"7335f9b427a03c77ca373c9f549de9c6102d3ba59783020e5c0f09560f7ec305");
    }
}
function test_pythonAdmissionCompletionAndFencedAbsenceRelations() public pure {
    G.Proposal memory p=proposal();
    (bool valid,R.Receipt memory r)=O.admission(p,authorityKey(),admissionBytes(),1000);assertTrue(valid);
    (valid,)=O.completion(p,r,providerKey(),effectBytes(),1000,2000);assertTrue(valid);
    (valid,)=O.completion(p,r,providerKey(),effectBytes(),1002,2000);assertFalse(valid);
    O.AbsenceEvidence memory evidence=O.AbsenceEvidence(fence(),updateBytes(),ackBytes(),absenceBytes());
    (valid,)=O.absence(p,authorityKey(),providerKey(),evidence,2000);assertTrue(valid);
    evidence.fence.fencingToken=9;
    (valid,)=O.absence(p,authorityKey(),providerKey(),evidence,2000);assertFalse(valid);
}

function test_pythonAttemptIdentityAndStableWork() public pure {
    G.Proposal memory p=proposal();
    assertEq(O.logicalWork(p),hex"94d8057833fb9824596abb61e6b3f5ddc8811e118e5f05fd0e76d41ea91dff47");
    O.AdmissionFacts memory facts;facts.proposalDigest=O.digest(p);
    (bool valid,R.Receipt memory receipt,)=R.tryDecode(admissionBytes());assertTrue(valid);
    facts.admissionDigest=R.digest(receipt);
    assertEq(O.attemptId(facts,hex"c1a8d222371285251f24bf60e755adc507e3094352bc470ab94341d79b902fc2",0,80002,
        address(0x2222222222222222222222222222222222222222)),hex"9d5c5681e3b2e052bb2d510ffebeaf59a88fa6fe46400e2387542937888807f6");
}
}
