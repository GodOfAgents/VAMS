pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {HeartbeatConsentV2} from "../src/trust/HeartbeatConsentV2.sol";

contract HeartbeatConsentV2CalldataHarness {
    function encodeBase(HeartbeatConsentV2.BaseIntent memory value) external pure returns (bytes memory) {
        return HeartbeatConsentV2.canonicalBaseBytes(value);
    }

    function decodeBase(bytes calldata raw) external pure returns (bool, HeartbeatConsentV2.BaseIntent memory) {
        return HeartbeatConsentV2.tryDecodeBaseCalldata(raw);
    }

    function decodeWitness(bytes calldata raw) external pure returns (bool, HeartbeatConsentV2.Witness memory) {
        return HeartbeatConsentV2.tryDecodeWitnessCalldata(raw);
    }
}

contract HeartbeatConsentV2Tests is Test {
