    function testRejectsMalformedFramesInMemoryAndCalldata() public {
        bytes memory base = hex"";
        bytes memory witness = hex"";

        _assertVector(base, witness, 0xe579297465adaed2c78d0e7bcc61dbca0e69db0c1913a7c1d1471811fca3b528, 0x0a73a28bf4b86db3ec1033b56bdb9e02bf758a5c7864a9b6c6f65ad211a54889);

        bytes memory bad = _copy(base);
        bad[0] = 0x00;
        _assertBaseRejected(bad);
        bad = _copy(base);
        bad[bytes("VAMS:GATEWAY:HEARTBEAT-CONSENT-BASE:v2").length - 1] = 0x31;
        _assertBaseRejected(bad);
        bad = _copy(base);
        uint256 baseOffset = bytes("VAMS:GATEWAY:HEARTBEAT-CONSENT-BASE:v2").length + 3;
        bad[baseOffset] = 0xff;
        _assertBaseRejected(bad);
        bad = _copy(base);
        bad[baseOffset] = bytes1(uint8(2));
        _assertBaseRejected(bad);
        bad = _copy(base);
        bad[baseOffset + 4] = bytes1(uint8(1));
        _assertBaseRejected(bad);
        bad = _copy(base);
        bad[baseOffset + 1] = 0;
        bad[baseOffset + 2] = bytes1(uint8(2));
        _assertBaseRejected(bad);
        bad = _copy(base);
        bad[bytes("VAMS:GATEWAY:HEARTBEAT-CONSENT-BASE:v2").length + 2] = 0x11;
        _assertBaseRejected(bad);
        bad = _dropLast(base);
        _assertBaseRejected(bad);
        bad = bytes.concat(base, hex"00");
        _assertBaseRejected(bad);

        bytes memory badWitness = _copy(witness);
        uint256 witnessOffset = bytes("VAMS:GATEWAY:HEARTBEAT-CONSENT-WITNESS:v2").length + 3;
        badWitness[witnessOffset] = 0xff;
        _assertWitnessRejected(badWitness);
        badWitness = _copy(witness);
        badWitness[witnessOffset + 35] = bytes1(uint8(1));
        _assertWitnessRejected(badWitness);
        badWitness = _copy(witness);
        badWitness[witnessOffset + 1] = 0;
        badWitness[witnessOffset + 2] = bytes1(uint8(31));
        _assertWitnessRejected(badWitness);
        badWitness = _copy(witness);
        badWitness[0] = 0;
        _assertWitnessRejected(badWitness);
        badWitness = _copy(witness);
        badWitness[bytes("VAMS:GATEWAY:HEARTBEAT-CONSENT-WITNESS:v2").length - 1] = 0x31;
        _assertWitnessRejected(badWitness);
        badWitness = _copy(witness);
        badWitness[bytes("VAMS:GATEWAY:HEARTBEAT-CONSENT-WITNESS:v2").length + 2] = 0x07;
        _assertWitnessRejected(badWitness);
        badWitness = _dropLast(witness);
        _assertWitnessRejected(badWitness);
        badWitness = bytes.concat(witness, hex"00");
        _assertWitnessRejected(badWitness);

        _assertBaseRejected(_padToLength(base, 1024));
        _assertBaseRejected(_padToLength(base, 1025));
        _assertWitnessRejected(_padToLength(witness, 1024));
        _assertWitnessRejected(_padToLength(witness, 1025));
    }

    function testShapeRulesAndMutationSensitivityAreNotAuthorization() public {
        bytes memory raw = hex"";
        (bool ok, HeartbeatConsentV2.BaseIntent memory base) = HeartbeatConsentV2.tryDecodeBase(raw);
        assertTrue(ok);
        HeartbeatConsentV2.BaseIntent memory changed = _freshBase(raw);
        changed.consentNonce += 1;
        assertTrue(HeartbeatConsentV2.validBase(changed));
        assertTrue(HeartbeatConsentV2.baseDigest(changed) != HeartbeatConsentV2.baseDigest(base));

        changed = _freshBase(raw);
        changed.principalId = bytes32(0);
        assertFalse(HeartbeatConsentV2.validBase(changed));
        HeartbeatConsentV2CalldataHarness encoderHarness = new HeartbeatConsentV2CalldataHarness();
        vm.expectRevert(HeartbeatConsentV2.InvalidBaseIntent.selector);
        encoderHarness.encodeBase(changed);

        changed = _freshBase(raw);
        changed.policyVersion = 0;
        assertFalse(HeartbeatConsentV2.validBase(changed));

        HeartbeatConsentV2.BaseIntent memory replacement = _freshBase(raw);
        replacement.mode = 2;
        replacement.expectedRecordDigest = bytes32(0);
        replacement.expectedGeneration = 7;
        replacement.proposedGeneration = 8;
        assertTrue(HeartbeatConsentV2.validBase(replacement));
        bytes memory replacementBytes = HeartbeatConsentV2.canonicalBaseBytes(replacement);
        (bool replacementOk, HeartbeatConsentV2.BaseIntent memory decodedReplacement) =
            HeartbeatConsentV2.tryDecodeBase(replacementBytes);
        assertTrue(replacementOk);
        assertEq(HeartbeatConsentV2.baseDigest(decodedReplacement), HeartbeatConsentV2.baseDigest(replacement));

        bytes memory witnessRaw = hex"";
        (bool witnessOk, HeartbeatConsentV2.Witness memory witness) = HeartbeatConsentV2.tryDecodeWitness(witnessRaw);
        assertTrue(witnessOk);
        assertTrue(HeartbeatConsentV2.matchesBaseData(witness, base));
        assertTrue(HeartbeatConsentV2.matchesBaseData(witness, base)); // repeated matching is not a replay-state transition
        witness.mode = 2;
        assertFalse(HeartbeatConsentV2.validWitness(witness));
        assertFalse(HeartbeatConsentV2.matchesBaseData(witness, base));
        (bool maskOk, uint8 mask) = HeartbeatConsentV2.requiredRoleMask(2);
        assertTrue(maskOk);
        assertEq(mask, 3);
        (maskOk, mask) = HeartbeatConsentV2.requiredRoleMask(99);
        assertFalse(maskOk);
        assertEq(mask, 0);
    }

    function _freshBase(bytes memory raw) private returns (HeartbeatConsentV2.BaseIntent memory value) {
        bool ok;
        (ok, value) = HeartbeatConsentV2.tryDecodeBase(raw);
        assertTrue(ok);
    }

    function _assertVector(bytes memory baseRaw, bytes memory witnessRaw, bytes32 baseHash, bytes32 witnessHash)
        private
    {
        (bool baseOk, HeartbeatConsentV2.BaseIntent memory base) = HeartbeatConsentV2.tryDecodeBase(baseRaw);
        assertTrue(baseOk);
        assertTrue(HeartbeatConsentV2.validBase(base));
        assertEq(keccak256(HeartbeatConsentV2.canonicalBaseBytes(base)), keccak256(baseRaw));
        assertEq(HeartbeatConsentV2.baseDigest(base), baseHash);

        (bool witnessOk, HeartbeatConsentV2.Witness memory witness) = HeartbeatConsentV2.tryDecodeWitness(witnessRaw);
        assertTrue(witnessOk);
        assertTrue(HeartbeatConsentV2.validWitness(witness));
        assertEq(keccak256(HeartbeatConsentV2.canonicalWitnessBytes(witness)), keccak256(witnessRaw));
        assertEq(HeartbeatConsentV2.witnessDigest(witness), witnessHash);
        assertTrue(HeartbeatConsentV2.matchesBaseData(witness, base));

        HeartbeatConsentV2CalldataHarness harness = new HeartbeatConsentV2CalldataHarness();
        (baseOk, base) = harness.decodeBase(baseRaw);
        assertTrue(baseOk);
        assertEq(HeartbeatConsentV2.baseDigest(base), baseHash);
        (witnessOk, witness) = harness.decodeWitness(witnessRaw);
        assertTrue(witnessOk);
        assertEq(HeartbeatConsentV2.witnessDigest(witness), witnessHash);
    }

    function _assertBaseRejected(bytes memory raw) private {
        (bool ok,) = HeartbeatConsentV2.tryDecodeBase(raw);
        assertFalse(ok);
        HeartbeatConsentV2CalldataHarness harness = new HeartbeatConsentV2CalldataHarness();
        (ok,) = harness.decodeBase(raw);
        assertFalse(ok);
    }

    function _assertWitnessRejected(bytes memory raw) private {
        (bool ok,) = HeartbeatConsentV2.tryDecodeWitness(raw);
        assertFalse(ok);
        HeartbeatConsentV2CalldataHarness harness = new HeartbeatConsentV2CalldataHarness();
        (ok,) = harness.decodeWitness(raw);
        assertFalse(ok);
    }

    function _copy(bytes memory source) private pure returns (bytes memory result) {
        result = new bytes(source.length);
        for (uint256 i; i < source.length; ++i) result[i] = source[i];
    }

    function _dropLast(bytes memory source) private pure returns (bytes memory result) {
        result = new bytes(source.length - 1);
        for (uint256 i; i < result.length; ++i) result[i] = source[i];
    }

    function _padToLength(bytes memory source, uint256 targetLength) private pure returns (bytes memory result) {
        require(source.length < targetLength, "target must exceed source");
        result = new bytes(targetLength);
        for (uint256 i; i < source.length; ++i) result[i] = source[i];
    }
}
