            0xe579297465adaed2c78d0e7bcc61dbca0e69db0c1913a7c1d1471811fca3b528,
            0x0a73a28bf4b86db3ec1033b56bdb9e02bf758a5c7864a9b6c6f65ad211a54889
        );
    }

    function testLiteralNormalRotationVector() public {
        _assertVector(
