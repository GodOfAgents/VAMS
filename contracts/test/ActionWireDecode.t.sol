pragma solidity ^0.8.20;
import {Test} from "forge-std/Test.sol";
import {ActionContextV1} from "../src/trust/ActionContextV1.sol";

contract ActionWireDecodeHarness19 {
    function decode(bytes memory raw) external pure returns (bool, ActionContextV1.Context memory) {
        return ActionContextV1.tryDecode(raw);
    }
}

contract ActionWireDecodeTest is Test {
    ActionWireDecodeHarness19 private decoder;
    function setUp() public { decoder = new ActionWireDecodeHarness19(); }
    function check(bytes memory raw, bool accepted, bytes32 expectedDigest) internal view {
        (bool ok, ActionContextV1.Context memory c) = decoder.decode(raw);
        assertEq(ok, accepted);
        if (ok) {
            assertEq(ActionContextV1.canonicalBytes(c), raw);
            assertEq(ActionContextV1.digest(c), expectedDigest);
        } else {
            assertEq(keccak256(abi.encode(c)), keccak256(new bytes(21 * 32)));
        }
    }
    function test_valid_base() public view {
        check(hex"", true, hex"efd6951ca159fbf351df14023724120c4e70a01ac4941a03933d770de5699573");
    }
    function test_valid_cardano_root() public view {
        check(hex"", true, hex"a15184a4f81ef4cb0f18dcdfdb2b37f92fc8b0f49f7c4affdbbf4449db62ab0b");
    }
    function test_valid_full_uint256() public view {
        check(hex"", true, hex"f6ee9cfc7e4e768df66444d1fabe0fe2aa149f976474f4a2143da125c7d20331");
    }
    function test_valid_zero_budget() public view {
        check(hex"", true, hex"92b07350d5fd96e397dc792f8971c08a556d953a3ed9ce44fd95b08ac1a81fa9");
    }
    function test_valid_start_zero() public view {
        check(hex"", true, hex"226ae05ae2ebacc48f9bffbf9408701963d60da14e9c3a9ed43b738f865a6e13");
    }
    function test_valid_nonzero_model() public view {
        check(hex"", true, hex"48dd150ee100916a30ba3f19929db90b3e073dea05638ada5f60950b33bb36a3");
    }
    function test_reject_empty() public view {
        check(hex"", false, bytes32(0));
    }
    function test_reject_truncated() public view {
        check(hex"", false, bytes32(0));
    }
    function test_reject_trailing() public view {
        check(hex"", false, bytes32(0));
    }
    function test_reject_wrong_domain() public view {
        check(hex"", false, bytes32(0));
    }
    function test_reject_wrong_version() public view {
        check(hex"", false, bytes32(0));
    }
    function test_reject_evm_root_padding() public view {
        check(hex"", false, bytes32(0));
    }
    function test_reject_cardano_root_padding() public view {
        check(hex"", false, bytes32(0));
    }
    function test_reject_zero_actor_root() public view {
        check(hex"", false, bytes32(0));
    }
    function test_reject_zero_provider() public view {
        check(hex"", false, bytes32(0));
    }
    function test_reject_zero_runtime() public view {
        check(hex"", false, bytes32(0));
    }
    function test_reject_zero_host() public view {
        check(hex"", false, bytes32(0));
    }
    function test_reject_zero_workflow() public view {
        check(hex"", false, bytes32(0));
    }
    function test_reject_zero_intent() public view {
        check(hex"", false, bytes32(0));
    }
    function test_reject_zero_action() public view {
        check(hex"", false, bytes32(0));
    }
    function test_reject_zero_input() public view {
        check(hex"", false, bytes32(0));
    }
    function test_reject_zero_policy() public view {
        check(hex"", false, bytes32(0));
    }
    function test_reject_zero_target() public view {
        check(hex"", false, bytes32(0));
    }
    function test_reject_zero_nonce() public view {
        check(hex"", false, bytes32(0));
    }
    function test_reject_zero_budget_unit() public view {
        check(hex"", false, bytes32(0));
    }
    function test_reject_scheme_0() public view {
        check(hex"", false, bytes32(0));
    }
    function test_reject_scheme_3() public view {
        check(hex"", false, bytes32(0));
    }
    function test_reject_zero_epoch() public view {
        check(hex"", false, bytes32(0));
    }
    function test_reject_zero_version() public view {
        check(hex"", false, bytes32(0));
    }
    function test_reject_zero_capabilities() public view {
        check(hex"", false, bytes32(0));
    }
    function test_reject_zero_chain() public view {
        check(hex"", false, bytes32(0));
    }
    function test_reject_equal_times() public view {
        check(hex"", false, bytes32(0));
    }
    function test_reject_reversed_times() public view {
        check(hex"", false, bytes32(0));
    }
    function putWord(bytes memory raw, uint256 index, bytes32 value) internal pure {
        for (uint256 i; i < 32; ++i) raw[23 + index * 32 + i] = value[i];
    }
    function base() internal pure returns (bytes memory) { return hex""; }
    function testFuzz_fullUint256Budget(uint256 budget) public view {
        bytes memory raw = base();
        putWord(raw,17,bytes32(budget));
        (bool ok, ActionContextV1.Context memory c) = decoder.decode(raw);
        assertTrue(ok);
        assertEq(c.budget,budget);
        assertEq(ActionContextV1.canonicalBytes(c),raw);
    }
    function testFuzz_cardanoRoot(bytes28 root) public view {
        vm.assume(root != bytes28(0));
        bytes memory raw = base();
        bytes32 actor = bytes32(uint256(uint224(root)));
        putWord(raw,0,actor);
        putWord(raw,13,bytes32(uint256(2)));
        (bool ok, ActionContextV1.Context memory c) = decoder.decode(raw);
        assertTrue(ok);
        assertEq(c.actorRoot,actor);
        assertEq(c.rootScheme,2);
        assertEq(ActionContextV1.canonicalBytes(c),raw);
    }
}
